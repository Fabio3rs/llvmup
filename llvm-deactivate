#!/bin/bash
# llvm-deactivate: Deactivates the currently active LLVM version.
# Usage:
#   source llvm-deactivate

# Check if script is being sourced
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    echo "Error: This script must be sourced, not executed directly."
    echo "Usage: source llvm-deactivate"
    exit 1
fi

# Check if any version is active
if [ -z "$_ACTIVE_LLVM" ]; then
    echo "No LLVM version is currently active."
    return 0
fi

# Restore environment variables
if [ -n "$_OLD_PATH" ]; then
    export PATH="$_OLD_PATH"
    unset _OLD_PATH
fi

if [ "${_OLD_CC_SET:-}" = "1" ]; then
    export CC="$_OLD_CC"
elif [ "${_OLD_CC_SET:-}" = "0" ] || [ -z "${_OLD_CC:-}" ]; then
    unset CC
else
    export CC="$_OLD_CC"
fi
unset _OLD_CC _OLD_CC_SET

if [ "${_OLD_CXX_SET:-}" = "1" ]; then
    export CXX="$_OLD_CXX"
elif [ "${_OLD_CXX_SET:-}" = "0" ] || [ -z "${_OLD_CXX:-}" ]; then
    unset CXX
else
    export CXX="$_OLD_CXX"
fi
unset _OLD_CXX _OLD_CXX_SET

if [ "${_OLD_LD_SET:-}" = "1" ]; then
    export LD="$_OLD_LD"
elif [ "${_OLD_LD_SET:-}" = "0" ] || [ -z "${_OLD_LD:-}" ]; then
    unset LD
else
    export LD="$_OLD_LD"
fi
unset _OLD_LD _OLD_LD_SET

if [ "${_OLD_PS1_SET:-}" = "1" ]; then
    export PS1="$_OLD_PS1"
elif [ "${_OLD_PS1_SET:-}" = "0" ] || [ -z "${_OLD_PS1:-}" ]; then
    unset PS1
else
    export PS1="$_OLD_PS1"
fi
unset _OLD_PS1 _OLD_PS1_SET

# Clear the active version indicator
unset _ACTIVE_LLVM
unset _ACTIVE_LLVM_PATH

echo "LLVM version deactivated. Environment variables have been restored."
