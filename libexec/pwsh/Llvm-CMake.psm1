# CMake toolchain file generation from installed toolchain manifests.

$script:EnvModule = Join-Path $PSScriptRoot 'Llvm-Environment.psm1'
if ((Test-Path -LiteralPath $script:EnvModule) -and -not (Get-Module -Name 'Llvm-Environment')) {
    Import-Module $script:EnvModule -DisableNameChecking
}

function ConvertTo-LlvmCMakePath {
    param([string]$Path)
    if (-not $Path) { return '' }
    return $Path.Replace('\', '/')
}

function Get-LlvmCMakeSystemAndProcessor {
    param([string]$TargetTriple, [string]$HostOs)

    $sysName = 'Windows'
    if ($TargetTriple -match 'linux') { $sysName = 'Linux' }
    elseif ($TargetTriple -match 'darwin|apple') { $sysName = 'Darwin' }
    elseif ($TargetTriple -match 'windows|mingw') { $sysName = 'Windows' }
    elseif ($HostOs -eq 'linux') { $sysName = 'Linux' }
    elseif ($HostOs -eq 'macos') { $sysName = 'Darwin' }

    $proc = 'AMD64'
    if ($TargetTriple -match '^(aarch64|arm64)') { $proc = 'ARM64' }
    elseif ($TargetTriple -match '^(armv7|arm)') { $proc = 'ARM' }
    elseif ($TargetTriple -match '^(i686|i386|x86)-') { $proc = 'X86' }

    return @{ SystemName = $sysName; Processor = $proc }
}

function New-LlvmCMakeToolchainFile {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]$Manifest,
        [string]$Target = '',
        [string]$Compiler = '',
        [string]$OutputPath = ''
    )

    $delta = Get-LlvmEnvironmentDelta -Manifest $Manifest -Target $Target -Compiler $Compiler
    $effTarget = if ($delta.target) { $delta.target } else { '' }
    $effCompiler = $delta.compiler
    $hostOs = if ($Manifest.host -and $Manifest.host.os) { [string]$Manifest.host.os } else { 'windows' }
    $cmakeMeta = Get-LlvmCMakeSystemAndProcessor -TargetTriple $effTarget -HostOs $hostOs

    $root = ConvertTo-LlvmCMakePath ([string]$Manifest.root_path)
    $cc = ConvertTo-LlvmCMakePath ([string]$delta.set['CC'])
    $cxx = ConvertTo-LlvmCMakePath ([string]$delta.set['CXX'])
    $ar = ConvertTo-LlvmCMakePath ([string]$delta.set['AR'])
    $ranlib = ConvertTo-LlvmCMakePath ([string]$delta.set['RANLIB'])
    $rc = ConvertTo-LlvmCMakePath ([string]$delta.set['RC'])
    $crt = if ($Manifest.variant -and $Manifest.variant.crt) { [string]$Manifest.variant.crt } else { 'unknown' }
    $cxxStdlib = if ($Manifest.variant -and $Manifest.variant.cxx_stdlib) { [string]$Manifest.variant.cxx_stdlib } else { 'unknown' }

    $sysrootCandidate = ''
    if ($effTarget -and (Test-Path -LiteralPath (Join-Path $Manifest.root_path $effTarget) -PathType Container)) {
        $sysrootCandidate = "$root/$effTarget"
    }

    $lines = @(
        "# Generated by LLVMUP cmake-toolchain",
        "# Provider: $($Manifest.provider) | Release: $($Manifest.provider_release) | LLVM: $($Manifest.llvm_version)",
        "# Target: $effTarget | Compiler: $effCompiler | CRT: $crt | C++ StdLib: $cxxStdlib",
        "# NOTE: Use a dedicated CMake build directory per toolchain/ABI/CRT/stdlib combination.",
        "#       Do not mix MSVC STL, libstdc++, libc++, UCRT, and MSVCRT binaries in one build cache.",
        "",
        "set(CMAKE_SYSTEM_NAME $($cmakeMeta.SystemName))",
        "set(CMAKE_SYSTEM_PROCESSOR $($cmakeMeta.Processor))"
    )

    if ($cc) { $lines += "set(CMAKE_C_COMPILER `"$cc`")" }
    if ($cxx) { $lines += "set(CMAKE_CXX_COMPILER `"$cxx`")" }
    if ($effCompiler -eq 'clang' -and $effTarget -and $Manifest.provider -eq 'official') {
        $lines += "set(CMAKE_C_COMPILER_TARGET `"$effTarget`")"
        $lines += "set(CMAKE_CXX_COMPILER_TARGET `"$effTarget`")"
    }
    if ($ar) { $lines += "set(CMAKE_AR `"$ar`" CACHE FILEPATH `"Archiver`")" }
    if ($ranlib) { $lines += "set(CMAKE_RANLIB `"$ranlib`" CACHE FILEPATH `"Ranlib`")" }
    if ($rc) { $lines += "set(CMAKE_RC_COMPILER `"$rc`" CACHE FILEPATH `"Resource compiler`")" }

    if ($sysrootCandidate) {
        $lines += "set(CMAKE_SYSROOT `"$sysrootCandidate`")"
        $lines += "set(CMAKE_FIND_ROOT_PATH `"$sysrootCandidate`" `"$root`")"
        $lines += "set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)"
        $lines += "set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)"
        $lines += "set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)"
        $lines += "set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)"
    } else {
        $lines += "set(CMAKE_FIND_ROOT_PATH `"$root`")"
        $lines += "set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)"
    }

    $text = ($lines -join "`n") + "`n"
    if ($OutputPath) {
        $fullOut = $ExecutionContext.SessionState.Path.GetUnresolvedProviderPathFromPSPath($OutputPath)
        $parent = Split-Path $fullOut -Parent
        if ($parent -and -not (Test-Path -LiteralPath $parent)) {
            $null = New-Item -ItemType Directory -Path $parent -Force
        }
        $utf8NoBom = [System.Text.UTF8Encoding]::new($false)
        [IO.File]::WriteAllText($fullOut, $text, $utf8NoBom)
        return $fullOut
    }
    return $text
}

Export-ModuleMember -Function @(
    'New-LlvmCMakeToolchainFile'
)
