#!/bin/bash
# Compatibility entrypoint for official installations. The recipe engine owns the installation.

# Source LLVM functions for directory configuration support
case "${BASH_SOURCE[0]}" in
    */*) SCRIPT_DIR="${BASH_SOURCE[0]%/*}" ;;
    *) SCRIPT_DIR="." ;;
esac
if [ -f "$SCRIPT_DIR/llvm-functions.sh" ]; then
    LLVMUP_DISABLE_AUTOACTIVATE=1 source "$SCRIPT_DIR/llvm-functions.sh"

    # Load configuration if .llvmup-config exists
    if [ "${LLVMUP_IGNORE_CONFIG:-0}" != 1 ] && [ -f ".llvmup-config" ]; then
        llvm-config-load >/dev/null 2>&1 || true
    fi
else
    echo "Error: llvm-functions.sh must be installed next to llvm-prebuilt." >&2
    exit 1
fi

# Parse command line arguments
VERBOSE=0
QUIET=0
VERIFY_REQUEST=""
CUSTOM_NAME=""
SET_DEFAULT=0
ARGS=()
PROFILE="${LLVM_CONFIG_PROFILE:-}"
COMPONENTS=("${LLVM_CONFIG_COMPONENTS[@]}")
if [ "${LLVMUP_IGNORE_CONFIG:-0}" = 1 ]; then PROFILE=""; COMPONENTS=(); fi
STRIP=0
COMPONENTS_CLI=0

while [[ $# -gt 0 ]]; do
    case $1 in
        --profile)
            [ $# -ge 2 ] || { echo "--profile requires a value" >&2; exit 1; }
            PROFILE="$2"; shift 2 ;;
        --component)
            [ $# -ge 2 ] || { echo "--component requires a value" >&2; exit 1; }
            if [ "$COMPONENTS_CLI" -eq 0 ]; then COMPONENTS=(); COMPONENTS_CLI=1; fi
            COMPONENTS+=("$2"); shift 2 ;;
        --strip) STRIP=1; shift ;;
        -v|--verbose)
            VERBOSE=1
            shift
            ;;
        -q|--quiet)
            QUIET=1
            shift
            ;;
        --verify)
            if [ $# -lt 2 ]; then
                echo "Option --verify requires warn, strict, or skip" >&2
                exit 1
            fi
            VERIFY_REQUEST="$2"
            shift 2
            ;;
        -n|--name)
            if [ $# -lt 2 ]; then
                echo "Option $1 requires an installation name" >&2
                exit 1
            fi
            CUSTOM_NAME="$2"
            shift 2
            ;;
        -d|--default)
            SET_DEFAULT=1
            shift
            ;;
        -h|--help)
            echo "Usage: $0 [OPTIONS] [VERSION]"
            echo ""
            echo "Options:"
            echo "  --profile NAME   minimal, compiler, full, or custom"
            echo "  --component NAME Add a selected component (repeatable)"
            echo "  --strip          Strip Linux ELF executables"
            echo "  -v, --verbose    Enable verbose output"
            echo "  -q, --quiet      Suppress non-essential output"
            echo "  --verify POLICY  Verification policy: warn, strict, or skip"
            echo "  -n, --name NAME  Use a custom installation name"
            echo "  -d, --default    Set the installed toolchain as default"
            echo "  -h, --help       Show this help message"
            echo ""
            echo "Arguments:"
            echo "  VERSION          Version expression, number, or tag (default: latest)"
            echo ""
            echo "Examples:"
            echo "  $0               # Install latest stable release"
            echo "  $0 latest        # Install latest stable release"
            echo "  $0 '~22.1'       # Install latest stable 22.1.x release"
            echo "  $0 llvmorg-19.1.7  # Install specific version"
            echo "  $0 -v 22.1.8     # Install with verbose output"
            exit 0
            ;;
        -*)
            echo "Unknown option $1"
            exit 1
            ;;
        *)
            ARGS+=("$1")
            shift
            ;;
    esac
done

# Restore positional parameters
set -- "${ARGS[@]}"
if [ $# -gt 1 ]; then
    echo "Only one LLVM version can be installed at a time" >&2
    exit 1
fi

case "$CUSTOM_NAME" in
    .|..|*/*|*\\*)
        echo "Invalid installation name: $CUSTOM_NAME" >&2
        exit 1
        ;;
esac

version="${1:-${LLVM_CONFIG_VERSION:-latest}}"
engine_args=("official@$version")
[ -z "$PROFILE" ] || engine_args+=(--profile "$PROFILE")
for component in "${COMPONENTS[@]}"; do engine_args+=(--component "$component"); done
[ "$STRIP" -eq 0 ] || engine_args+=(--strip)
[ "$SET_DEFAULT" -eq 0 ] || engine_args+=(--default)
[ "$QUIET" -eq 0 ] || engine_args+=(--quiet)
[ "$VERBOSE" -eq 0 ] || engine_args+=(--verbose)
[ -z "$VERIFY_REQUEST" ] || engine_args+=(--verify "$VERIFY_REQUEST")
[ -z "$CUSTOM_NAME" ] || engine_args+=(--name "$CUSTOM_NAME")
LLVM_TOOLCHAINS_DIR="$(llvm-get-toolchains-dir)" || exit 1
export LLVM_TOOLCHAINS_DIR
exec /bin/bash "$SCRIPT_DIR/libexec/sh/llvmup-engine.sh" install "${engine_args[@]}"
